# NWIS Backend Configuration
# Copy this file to .env in the same folder and fill in real values.

# Any secret string — used to sign auth tokens for the (currently unused-by-frontend) Postgres auth routes.
JWT_SECRET=change_me

# Where the Python AI service (nwis-ai/nwis-ai, run via `uvicorn app.main:app --port 8001`) is listening.
AI_SERVICE_URL=http://localhost:8001

# How often (ms) the simulated live-drilling feed advances and polls the AI service for new risk alerts.
DRILLING_TICK_MS=4000
